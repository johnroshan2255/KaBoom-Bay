# WebSocket endpoint of the Colyseus backend
VITE_SERVER_URL=ws://localhost:2567

# Production must point at a secure WebSocket (wss://): CrazyGames serves the game over https.
# VITE_SERVER_URL=wss://play.example.com

# The production build only runs on CrazyGames domains (sitelock requirement). Set to "off" to host elsewhere.
# VITE_SITELOCK=off
